# Entity: schedule

main: kit: entity: schedule: {

  alias: field: {}

  fields: [
    {
      format: "date"
      name: "date"
      req: false
      type: "`$STRING`"
    }
    {
      name: "games"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "totalEvents"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "totalGames"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "totalItems"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "totalMatches"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "schedule"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "end_date"
                orig: "end_date"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "season"
                orig: "season"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "start_date"
                orig: "start_date"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "team_id"
                orig: "team_id"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/schedule"
          segments: [
            {
              lit: "schedule"
            }
          ]
          select: {
            exist: [
              "end_date"
              "season"
              "start_date"
              "team_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.dates`"
          }
        }
      ]
    }
  }



}
