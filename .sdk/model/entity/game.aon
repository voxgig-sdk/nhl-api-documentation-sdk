# Entity: game

main: kit: entity: game: {

  alias: field: {}

  fields: [
    {
      name: "away"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "copyright"
      req: false
      type: "`$STRING`"
    }
    {
      name: "gameData"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "gamePk"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "home"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "link"
      req: false
      type: "`$STRING`"
    }
    {
      name: "liveData"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "game"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/game/{id}/boxscore"
          segments: [
            {
              lit: "game"
            }
            {
              var: "id"
            }
            {
              lit: "boxscore"
            }
          ]
          select: {
            "$action": "boxscore"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.teams`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/game/{id}/feed/live"
          segments: [
            {
              lit: "game"
            }
            {
              var: "id"
            }
            {
              lit: "feed"
            }
            {
              lit: "live"
            }
          ]
          select: {
            "$action": "feed_live"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
